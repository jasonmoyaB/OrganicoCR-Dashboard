# Secretos — nunca se commitean.
#
# Los patrones sin barra matchean a cualquier profundidad, así que `.env` cubre
# también `supabase/functions/.env`.
#
# `.env.*` está por los respaldos: `.env.local.bak-local` se escapaba de
# `*.local` porque termina en "-local" y no en ".local", y un `git add -A` lo
# habría commiteado con las credenciales reales de la tienda adentro.
.env
.env.*
!.env.example
*.local

# Dependencias
node_modules
.pnpm-store

# Build
dist
dist-ssr
*.tsbuildinfo

# Supabase local
supabase/.branches
supabase/.temp

# Editores
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
