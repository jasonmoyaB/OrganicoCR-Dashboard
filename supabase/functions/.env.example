# Plantilla de los secretos de las Edge Functions. Copiar a `.env` y rellenar.
#
# `.env` está ignorado por regla explícita en .gitignore:6 — verificable con
#   git check-ignore -v supabase/functions/.env
# Este `.example` sí se commitea: lleva los nombres, nunca los valores.
#
# Ninguna variable puede empezar con `SUPABASE_`: ese prefijo está reservado y
# el runtime de Deno no la expone. Ver docs/referencia/entorno.md.

# Secreto compartido con el webhook de WooCommerce (HMAC-SHA256).
WOO_WEBHOOK_SECRET=

# Buzón del banco. Dovecot de cPanel, TLS directo en el 993.
# El buzón se abre con EXAMINE (solo lectura): el servidor rechaza marcar
# leído o borrar, así que la función no puede modificar el correo del negocio.
CORREO_IMAP_HOST=mail.organicocr.store
CORREO_IMAP_PUERTO=993
CORREO_IMAP_USUARIO=info@organicocr.store
CORREO_IMAP_CLAVE=

# Solo para el servidor IMAP de pruebas local (Greenmail), que usa un
# certificado propio. En produccion va vacio y rige la confianza del sistema.
CORREO_IMAP_CA_PEM=

# Notificaciones push. El par se genera con `node scripts/generar-vapid.mjs`,
# que imprime las dos líneas ya armadas.
#
# VAPID_KEYS lleva la llave PRIVADA. Con ella cualquiera puede mandarle
# notificaciones al dueño haciéndose pasar por el dashboard.
# VAPID_CONTACTO tiene que ser un mailto: o un https: (RFC 8292): es a quién
# le escribe el servicio de push si nuestros avisos dan problemas.
VAPID_CONTACTO=mailto:info@organicocr.store
VAPID_KEYS=

# Respaldo LLM del extractor de correos (Anthropic Console).
#
# OPCIONAL: sin esta clave el poll funciona igual que siempre, solo que un
# correo con formato nuevo queda en `procesado_ok = false` para mirar a mano.
# Por eso no hace falta ponerla en local.
#
# Se usa unicamente cuando ningun regex reconoce el aviso. El modelo extrae
# datos del correo; que pago va con que pedido lo sigue decidiendo SQL
# (invariante 6).
ANTHROPIC_API_KEY=
