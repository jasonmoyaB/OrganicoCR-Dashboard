# Plantilla. Copiar a .env.local y completar.
# .env.local está en .gitignore y nunca se commitea.

# --- WooCommerce (solo lectura) ---
# Generar en: /wp-admin/admin.php?page=wc-settings&tab=advanced&section=keys
# Permisos: Lectura. El sistema nunca escribe a la tienda.
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- Supabase: desarrollo local ---
# Valores que imprime `supabase start`.
# VITE_* termina en el bundle del navegador: ahí solo va la publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sin prefijo VITE_: scripts de Node y Edge Functions. Nunca el navegador.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Supabase: producción ---
# Mantener comentadas en desarrollo. Activarlas hace que los scripts
# escriban en la base real.
# PROD_SUPABASE_URL=
# PROD_SUPABASE_PUBLISHABLE_KEY=
# PROD_SUPABASE_SECRET_KEY=

# --- Webhook de WooCommerce ---
# Distinto de la API key. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WOO_WEBHOOK_SECRET=

# --- Usuario del dashboard (solo desarrollo local) ---
# `supabase db reset` borra auth.users. Recrearlo con: pnpm usuario:dev
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# --- Notificaciones push (VAPID) ---
# Generar el par con: node scripts/generar-vapid.mjs
# Esta mitad es pública por diseño: es lo que el navegador le muestra al
# servicio de push para que acepte avisos firmados por nosotros. La privada
# vive en supabase/functions/.env y nunca lleva el prefijo VITE_.
VITE_VAPID_PUBLIC_KEY=
