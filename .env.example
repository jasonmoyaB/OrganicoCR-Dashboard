# Plantilla. Copiar a .env.local y completar.
# .env.local está en .gitignore y nunca se commitea.

# --- WooCommerce (solo lectura) ---
# Generar en: /wp-admin/admin.php?page=wc-settings&tab=advanced&section=keys
# Permisos: Lectura. El sistema nunca escribe a la tienda.
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- Supabase: frontend ---
# VITE_* termina en el bundle del navegador. Nunca poner service_role acá.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase: scripts locales ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Webhook de WooCommerce ---
# Distinto de la API key. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WOO_WEBHOOK_SECRET=
